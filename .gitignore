# Secrets — the gateway virtual key
.env

# Python bytecode
__pycache__/
*.py[cod]

# Scratch/backup files. History lives in git now, so these are not kept.
*.bak
*.bak-*
*.bak2
*.bak3
*.bak4
*.pre-revise

# The build output. docs/ is the committed copy GitHub Pages serves from main;
# site/ is the working build directory and is never committed.
site/

# Live run output — noisy, machine-local, no value to a reader
logs/
state/forge_skips.log
state/queue.lock
state/.forge_tick.lock

# Review working state. Regenerable, and it is the model's own scratch output
# (raw findings, verdicts, gate reports) rather than source. The one exception is
# state/diagrams/ below: those specs are a build input for diagrams.py.
state/reviews/
state/verdicts/
state/reports/

# Scaffold leftovers. The reader stylesheet lives inside build.py's CSS block;
# these were written by the theme scaffolder and are not imported.
site/tokens.css
site/base.css
site/book.css
docs/base.css
docs/book.css
docs/tokens.css
